		<style type="text/css" id="wp-custom-css">
			/* FORM - SICAM 2025 */

.form-two-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  column-gap: 40px;
  row-gap: 0px;
}

.form-two-columns .form-col {
  grid-column: auto;
}

.form-two-columns .form-full {
  grid-column: 1 / -1;
}

.form-two-columns p.form-col {
    margin-bottom: 0px;
}

@media (max-width: 768px) {
  .form-two-columns {
    grid-template-columns: 1fr;
  }
}

.form-two-columns input[type="text"],
.form-two-columns input[type="email"],
.form-two-columns input[type="tel"],
.form-two-columns textarea {
  background-color: #27252D; /* sfondo scuro */
  border: none;               /* nessun bordo */
  color: #ffffff;             /* testo bianco */
  padding: 10px 12px;         /* spazio interno */
  width: 100%;                /* larghezza piena del container */
  box-sizing: border-box;     /* include padding nella larghezza */
}

/* Stile del pulsante submit */
.form-two-columns input[type="submit"] {
  background-color: #ffffff;   /* sfondo bianco */
  color: #27252D;              /* testo scuro per contrasto */
  font-weight: bold;           /* testo bold */
  padding: 12px 30px;          /* spazio interno generoso */
  border: none;                /* nessun bordo */
  border-radius: 50px;         /* angoli arrotondati a pill */
  cursor: pointer;
  transition: background-color 0.3s, color 0.3s; /* transizione morbida */
}

/* Hover sul pulsante */
.form-two-columns input[type="submit"]:hover {
  background-color: #e0e0e0;  /* leggero cambio colore su hover */
  color: #27252D;
}


p.custom {
    font-family: 'Instrument Sans';
    margin-top: 20px;
}


p > a { text-decoration: underline }



/* FOOTER NAV */

.grid-container.footer__nav .cell {
    width: 100% !important;
}

/* PUNTI ELENCO CON LINK UNDERLINE */

ul.wp-block-list li a {
    text-decoration: underline !important;
}		</style>
