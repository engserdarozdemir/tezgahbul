            <div class="cell small-12">
                <label for="city">Città</label>
                <input id="city" maxlength="40" name="city" size="20" type="text" required />
            </div>
            <div class="cell small-12">
                <label for="description">Descrizione</label><textarea id="description" name="description"
                    rows="3"></textarea>
            </div>
            <div class="cell small-12 checkbox-wrapper">
                <input type="checkbox" id="privacy" value="accetto" required><label
                    for="privacy">Dichiaro di aver letto e accettato la Privacy Policy*</label>
            </div>
            <div class="cell small-12">
                <input class="button rounded sf_submit" type="submit" id="submitBtn" disabled
                    value="Invia richiesta">
            </div>
            <div class="cell small-12">
                <div class="g-recaptcha" data-sitekey="6LeFVO0rAAAAANJrfpc_DmWDJkC-cTzcR6Nyw0vw"
                    data-callback="enableSubmit"></div>
            </div>
        </div>
        <input type="hidden" id="Divisione__c" name="Divisione__c" value="INF" />
    </form>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>

        function enableSubmit() {
            document.getElementById('submitBtn').disabled = false;
        }

        document.addEventListener("DOMContentLoaded", function () {
            const countrySelect = document.getElementById("country_code");
            const stateSelect = document.getElementById("state_code");
            // Salviamo tutte le option originali di state_code
            const allStateOptions = Array.from(stateSelect.options);
            // Inizialmente nascondiamo il campo State
            // stateSelect.style.display = "none";
            countrySelect.addEventListener("change", function () {
                const country = this.value;
                stateSelect.innerHTML = ""; // puliamo la select
                if (country) {
                    // filtriamo solo le option che iniziano con il country_code
                    const filteredOptions = allStateOptions.filter(opt => opt.value === "" || opt.value
                        .startsWith(country));
                    filteredOptions.forEach(opt => stateSelect.appendChild(opt));
                    // stateSelect.style.display = "block";
                } else {
                    // se non è selezionato nessun paese, nascondiamo
                    // stateSelect.style.display = "none";
                }
            });
        });
    </script> </p>
